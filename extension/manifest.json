{
  "manifest_version": 3,
  "name": "NexGen Live Studio · Meet Audio",
  "description": "Connect a single, explicitly selected Google Meet tab to NexGen Live Studio on this computer.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "offscreen", "storage", "tabCapture"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {"service_worker": "worker.js"},
  "action": {"default_title": "NexGen Live Studio", "default_popup": "popup.html"}
}
