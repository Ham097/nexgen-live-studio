{
  "manifest_version": 3,
  "name": "NexGen Live Studio · Meet Audio",
  "description": "Connect a single, explicitly selected Google Meet tab to NexGen Live Studio on this computer.",
  "version": "0.2.0",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "offscreen", "storage", "tabCapture", "nativeMessaging", "alarms"],
  "host_permissions": ["http://127.0.0.1/*", "https://meet.google.com/*"],
  "background": {"service_worker": "worker.js"},
  "action": {"default_title": "Allow this Meet tab in NexGen Live Studio", "default_popup": "connect.html"}
}
